# Copy to .env to override defaults. Every line is optional.
# The same file is read by a local run (make run) and by docker compose.

# --- Speech-to-text model ---
# Any Whisper model in CTranslate2 format on the Hugging Face Hub.
# In Docker the model is baked into the image at build time, so change it with:
#   docker compose build --build-arg WHISPER_MODEL=<repository>
# WHISPER_MODEL=Systran/faster-whisper-small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=0
# WHISPER_BEAM_SIZE=5

# --- Limits ---
# MAX_UPLOAD_MB=2048
# MAX_DURATION_MINUTES=240
# MAX_PENDING_JOBS=10
# MAX_JOB_ATTEMPTS=2

# --- Storage and logging ---
# DATA_DIR=data
# LOG_LEVEL=INFO
# LOG_FORMAT=text
