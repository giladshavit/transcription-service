# Copy to .env to override defaults. Every line is optional.
# The same file is read by a local run (make run) and by docker compose.

# --- Speech-to-text model ---
# Any Whisper model in CTranslate2 format on the Hugging Face Hub.
# In Docker the model is baked into the image, so a change takes effect on the next
# build: docker compose up --build
# WHISPER_MODEL=Systran/faster-whisper-small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=0
# WHISPER_BEAM_SIZE=5

# --- Limits ---
# MAX_UPLOAD_MB=2048
# MAX_DURATION_MINUTES=60
# MAX_PENDING_JOBS=10
# MAX_JOB_ATTEMPTS=2

# --- Storage and logging ---
# DATA_DIR=data
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# --- Docker only ---
# The port on this machine that docker compose publishes the service on.
# PORT=8000
